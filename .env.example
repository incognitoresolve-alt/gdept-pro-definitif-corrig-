# RECONSTRUCTION — ce fichier n'a été retrouvé nulle part dans le dépôt
# (ni dans les fichiers actuels, ni dans l'historique Git). Reconstruit à
# partir des variables réellement utilisées dans src/firebase.js,
# src/pages/Settings.jsx et src/components/TabContent.jsx.
# Copier en .env à la racine du projet et remplir avec ton projet Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clés publiques Stripe (Price IDs), utilisées dans src/pages/Settings.jsx
VITE_STRIPE_PRICE_MONTHLY=
VITE_STRIPE_PRICE_YEARLY=

# Code admin pour valider les tâches "en attente" (src/components/TabContent.jsx)
# Optionnel — si absent, la valeur par défaut "0000" est utilisée dans le code.
VITE_ADMIN_PIN=
