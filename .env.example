# Copier ce fichier en .env à la racine du projet, puis remplir avec les valeurs
# de ton projet Firebase (Console Firebase > Paramètres du projet > Général > Vos applications)
# et les identifiants de prix Stripe (Dashboard Stripe > Produits).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Identifiants de prix Stripe (mode Checkout), voir README_DEPLOIEMENT.md
VITE_STRIPE_PRICE_MONTHLY=
VITE_STRIPE_PRICE_YEARLY=
