# Copier ce fichier en .env dans le dossier functions/
# Contient uniquement des valeurs NON sensibles (les secrets Stripe passent par Secret Manager, voir README_DEPLOIEMENT.md)

APP_URL=https://ton-domaine.be

# Doivent correspondre exactement à VITE_STRIPE_PRICE_MONTHLY / VITE_STRIPE_PRICE_YEARLY
# (fichier .env racine) — utilisés pour vérifier qu'un client n'envoie pas un price id
# arbitraire à createCheckoutSession.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
